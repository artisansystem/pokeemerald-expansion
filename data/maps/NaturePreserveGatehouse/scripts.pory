mapscripts NaturePreserveGatehouse_MapScripts {}

script NaturePreserveGatehouse_PartyChecker_Trigger00 {
    lockall
    setvar(VAR_0x8008, 0)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger01 {
    lockall
    setvar(VAR_0x8008, 1)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger02 {
    lockall
    setvar(VAR_0x8008, 2)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger03 {
    lockall
    setvar(VAR_0x8008, 3)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger04 {
    lockall
    setvar(VAR_0x8008, 4)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger05 {
    lockall
    setvar(VAR_0x8008, 5)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger06 {
    lockall
    setvar(VAR_0x8008, 6)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger07 {
    lockall
    setvar(VAR_0x8008, 7)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_Trigger08 {
    lockall
    setvar(VAR_0x8008, 8)
    goto(NaturePreserveGatehouse_PartyChecker_PartyCheck)
}

script NaturePreserveGatehouse_PartyChecker_PartyCheck {
    
    switch(var(VAR_0x8008)) {
        case 0:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_00)
        case 1: 
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_01)
        case 2:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_02)
        case 3:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_03)
        case 4:
        default:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_04)
        case 5:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_05)
        case 6:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_06)
        case 7:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_07)
        case 8:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoToPlayer_08)
    }
    
    waitmovement(LOCALID_KINGSISLE_PARTYCHECKER)
    if (getpartysize == 0) {
    setspeaker(SP_NAME_STUDENT)
    msgbox(NaturePreserveGatehouse_Text_DontHavePokemon, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up * 2, face_down))
    applymovement(LOCALID_KINGSISLE_PARTYCHECKER, moves(walk_up * 2, walk_down * 2))
    waitmovement (LOCALID_KINGSISLE_PARTYCHECKER)

    switch(var(VAR_0x8008)) {
        case 0:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_00)
        case 1:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_01)
        case 2:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_02)
        case 3:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_03)
        case 4:
        default:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_04)
        case 5:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_05)
        case 6: 
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_06)
        case 7:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_07)
        case 8:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_08)
    }
    waitmovement
    releaseall
    end 
    } elif (getpartysize > 0) {
    setvar(VAR_KINGSISLE_INTRO_STATE, 6)
    setspeaker(SP_NAME_STUDENT)
    msgbox(NaturePreserveGatehouse_Text_EnjoyThePreserve, MSGBOX_DEFAULT)
    closemessage
    switch(var(VAR_0x8008)) {
        case 0:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_00)
        case 1:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_01)
        case 2:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_02)
        case 3:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_03)
        case 4:
        default:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_04)
        case 5:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_05)
        case 6: 
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_06)
        case 7:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_07)
        case 8:
            applymovement(LOCALID_KINGSISLE_PARTYCHECKER, NaturePreserveGatehouse_PartyChecker_GoBackToSeat_08)
    }
    waitmovement
    releaseall
    end
    }
}

movement NaturePreserveGatehouse_PartyChecker_GoToPlayer_00
{
    emote_exclamation_mark
    walk_down * 2
    walk_left * 1
    face_up
    step_end
}

movement NaturePreserveGatehouse_PartyChecker_GoToPlayer_01
{
    emote_exclamation_mark
    walk_down * 3
    walk_right * 4
    walk_up
    step_end
}

