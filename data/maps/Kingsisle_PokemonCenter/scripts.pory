mapscripts Kingsisle_PokemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Kingsisle_PokemonCenter_OnTransition
}

script Kingsisle_PokemonCenter_OnTransition {
    setrespawn(HEAL_LOCATION_KINGSISLE_INSTITUTE)
    end
}

script Kingisle_PokemonCenter_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_KINGSISLE_NURSE)
    if (getpartysize == 0)
    {
        lock
        faceplayer
        msgbox(Kingsisle_PkmnCenterNurse_Text_NoPokemon, MSGBOX_DEFAULT)
        applymovement(LOCALID_KINGSISLE_NURSE, moves(nurse_joy_bow, delay_4))
        msgbox(Kingsisle_PkmnCenterNurse_Text_SeeYouAgain, MSGBOX_DEFAULT)
        waitmovement
        release
        end

    }
    elif (getpartysize > 0)
    {
        call(Common_EventScript_PkmnCenterNurse)
        waitmessage
        waitbuttonpress
        release
        end  
    }

}

text Kingsisle_PkmnCenterNurse_Text_NoPokemon
{
    format("Hello, and welcome to the Pokémon Center. I can't help but notice that you don't have any Pokémon with you. We would be happy to serve you once you obtain a Pokémon.")
}

text Kingsisle_PkmnCenterNurse_Text_SeeYouAgain
{
    format("We hope to see you again!")
}